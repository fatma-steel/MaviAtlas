@model MaviAtlas.Models.Tur

@if (Model != null)
{
    <div class="position-fixed shadow rounded-3 overflow-hidden d-flex flex-column border border-light-subtle" 
         style="top: 80px; right: 20px; width: 230px; z-index: 1050; background-color: rgba(255, 255, 255, 0.85); backdrop-filter: blur(8px);">
        
        <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom" style="background-color: rgba(13, 110, 253, 0.1);">
            <span class="text-primary fw-bold" style="font-size: 0.75rem; letter-spacing: 0.2px;">GÜNÜN CANLISI</span>
            <button type="button" class="btn-close" style="font-size: 0.5rem;" 
                    onclick="this.closest('.position-fixed').remove(); return false;" aria-label="Kapat"></button>
        </div>
        
        <a asp-controller="Tur" asp-action="Detay" asp-route-id="@Model.Id" class="text-decoration-none text-dark p-3 d-block" 
           style="transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='rgba(0,0,0,0.03)'" onmouseout="this.style.backgroundColor='transparent'">
            
            @if (!string.IsNullOrEmpty(Model.FotoKaynak))
            {
                <img src="@Model.FotoKaynak" alt="@Model.TurkceAd" class="w-100 rounded mb-2 object-fit-cover shadow-sm" style="height: 110px;" />
            }

            <h6 class="fw-bold text-dark mb-2 text-truncate" title="@Model.TurkceAd">@Model.TurkceAd</h6>
            
            <div class="d-flex flex-column gap-1 text-muted" style="font-size: 0.8rem;">
                <div class="d-flex justify-content-between border-bottom pb-1 border-secondary-subtle">
                    <span class="fw-medium">Grup:</span>
                    <span>@Model.Grup</span>
                </div>
                <div class="d-flex justify-content-between pt-1">
                    <span class="fw-medium">Gövde:</span>
                    <span>@Model.Govde</span>
                </div>
            </div>
        </a>
    </div>
}