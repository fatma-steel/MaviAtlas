@model List<MaviAtlas.Models.Tur>
@{
	ViewData["Title"] = "Olası türler";
	ViewData["Arka"] = "arka-balina";
}

<h1> @Model.Count olası tür </h1>
<p> Yaşam alanı: @ViewBag.Alan  Vücut yapısı: @ViewBag.Govde </p>

@if (Model.Count == 0)
{
	<p> Bu özelliklere uyan tür bulunamadı. Daha az seçenek işaretlemeyi dene. </p>

}

<div class="="karlar">
	@foreach(var t in Model)
	{
		<div class="kart">
			<h3> @t.TurkceAd </h3>
			<p><em> @t.BilimselAd </em></p>
			<p>@t.Grup - @t.YasamAlani </p>
			<p> <a asp-controller = "Tur" asp-action ="Detay" asp-route-id="@t.Id">Detay</a></p>
		</div>
	}
</div>

<p class = "uyari"> Sonuç kesin tür adı değil, olası türlerdir.</p>
<p> <a asp-action="Index">Yeniden dene </a></p>