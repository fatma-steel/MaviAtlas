@model List<MaviAtlas.Models.Tur>
	@{
		ViewData["Title"]="Türler";
		var gruplar=(List<string>)ViewBag.Gruplar;
	}
	<h1>Deniz canlıları </h1>
	<p>@Model.Count tür listeleniyor</p>
	<p><a asp-action="Gruplar">Gruplara göre göster</a></p>

	<form method="get">
		<label>Grup
			<select name="grup">
				<option value="">Tümü</option>
				@foreach (var g in gruplar)
				{
						<option value="@g" selected="@(g==(string?)ViewBag.SeciliGrup)">@g</option>
					}
			</select>
		</label>
		<button type="submit" class="btn btn-primary">Filtrele</button>
	</form>
	<div class="kartlar">
			@foreach (var t in Model)
		{
		<div class="kart">
			<a asp-action="Detay" asp-route-id="@t.Id">
				<img src="~/images/turler/@(t.Id).jpg" alt="@t.TurkceAd" class="kart-foto" onerror="this.style.display='none'" />
			</a>
			<h3><a asp-action="Detay" asp-route-id="@t.Id">@t.TurkceAd</a></h3>
			<p><em>@t.BilimselAd</em></p>
			<p>@t.Grup - @t.YasamAlani</p>
		</div>
		}
	</div>
		